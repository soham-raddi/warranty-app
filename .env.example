# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.

# --- Required everywhere -------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_secure_random_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Production storage (Supabase). Leave empty locally to use inventory.db and the uploads/ folder --
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=
# Supabase -> Project Settings -> API: Project URL and the service_role key (keep this secret!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Name of the PRIVATE storage bucket for receipts
SUPABASE_BUCKET=receipts

# --- Production extras ---------------------------------------------------------------------------
# Long random string; Vercel Cron sends it to /api/cron/daily so nobody else can trigger the job
CRON_SECRET=
# Shown on the Privacy Policy and Terms pages
CONTACT_EMAIL=you@example.com

# --- Optional ------------------------------------------------------------------------------------
# Groq models; change these if Groq retires a model. The vision model must accept images.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# false = invite-only site (people can only join existing families)
ALLOW_NEW_WORKSPACES=true
# Only used once, when upgrading an install from before workspaces existed
OWNER_EMAIL=your-email@gmail.com
# Rate limits on scans, chat and sign-in (keep on in production)
RATE_LIMITS_ENABLED=true

# --- Local development only (ignored on Vercel) --------------------------------------------------
# Sign in without Google from 127.0.0.1; /auth/dev-login?email=x@example.com tests other families
ALLOW_DEV_LOGIN=false
FLASK_DEBUG=false
