# LLM API Key
GROQ_API_KEY=your_groq_api_key_here

# Groq models (optional). Groq retires models over time; change these if a model stops working.
# The vision model must accept images (used for receipt scanning and reading receipts in chat).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# App Secret Key (required for sessions to survive restarts)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_secure_random_key_here

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Anyone with a Google account can sign in. People who are not invited to a family can create their own
# workspace; set this to false to make the site invite-only (people can only join existing families).
ALLOW_NEW_WORKSPACES=true

# Only used once, when upgrading an install from before workspaces: this account becomes owner of the
# first workspace. Dev login also signs in as this address by default.
OWNER_EMAIL=your-email@gmail.com

# Set to true when the site is served over https, so the login cookie is never sent over plain http.
SESSION_COOKIE_SECURE=false

# Local dev login without Google. Off unless set to true, and only works from 127.0.0.1.
# /auth/dev-login?email=someone@example.com signs in as another address, to test several families locally.
ALLOW_DEV_LOGIN=false

# Flask debug mode for local development (never enable on a server reachable by others)
FLASK_DEBUG=false

# SMTP password for warranty reminder emails (kept out of the database)
WARRANTY_SMTP_PASSWORD=
