# LLM API Key
GROQ_API_KEY=your_groq_api_key_here

# Groq models (optional). Groq retires models over time; change these if a model stops working.
# The vision model must accept images (used for receipt scanning and reading receipts in chat).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# App Secret Key (required for sessions to survive restarts)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_secure_random_key_here

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Workspace Owner Restriction (optional: if omitted, the first signed-in Google account becomes owner)
OWNER_EMAIL=your-email@gmail.com

# Local dev login as the owner without Google. Off unless set to true, and only works from 127.0.0.1.
ALLOW_DEV_LOGIN=false

# Flask debug mode for local development (never enable on a server reachable by others)
FLASK_DEBUG=false

# SMTP password for warranty reminder emails (kept out of the database)
WARRANTY_SMTP_PASSWORD=
